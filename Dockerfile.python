FROM python:3.14-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 UV_LINK_MODE=copy UV_COMPILE_BYTECODE=1
WORKDIR /app
RUN pip install --no-cache-dir uv==0.11.15
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-dev --no-install-project
COPY contracts ./contracts
COPY configs ./configs
COPY backend ./backend
COPY atcs_simulator ./atcs_simulator
COPY adaptive ./adaptive
COPY database ./database
COPY alembic.ini ./
RUN useradd --create-home sigap && mkdir -p /app/work/media /app/work/history /app/work/analytics && chown -R sigap:sigap /app/work
USER sigap
ENV PATH="/app/.venv/bin:$PATH"
CMD ["uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8000", "--no-proxy-headers"]
