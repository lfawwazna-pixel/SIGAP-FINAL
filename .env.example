# Nilai lokal. Isi password PostgreSQL sendiri; jangan commit .env.
POSTGRES_DB=sigap
POSTGRES_USER=sigap
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
BACKEND_PORT=8000
ATCS_PORT=8001
FRONTEND_PORT=5173

# Proses Python lokal memakai field ini; Compose mengganti host menjadi db.
SIGAP_DB_HOST=127.0.0.1
SIGAP_DB_PORT=5432
SIGAP_CONFIG_PATH=configs/intersection.json
SIGAP_ATCS_BASE_URL=http://127.0.0.1:8001
# Rahasia antarlayanan, minimal 32 karakter acak. Jangan gunakan variabel VITE_ untuk ini.
SIGAP_CONTROL_API_KEY=
# Hanya true untuk instance uji integrasi terpisah; bukan ruang Simulasi 2F.
ATCS_ENABLE_TEST_SOURCE=false

# Sesi operator: 8 jam absolut. Gunakan true ketika melayani HTTPS.
SIGAP_SESSION_SECONDS=28800
SIGAP_COOKIE_SECURE=false
# Origin browser yang diizinkan; sesuaikan jika port frontend berubah.
SIGAP_ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

# Proxy server Vite; variabel ini tidak dimasukkan ke bundle browser.
BACKEND_PROXY_TARGET=http://127.0.0.1:8000
# Hanya URL publik relatif, bukan token atau password.
VITE_API_BASE_URL=/api
