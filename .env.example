# Nilai lokal. Isi password PostgreSQL sendiri; jangan commit .env.
POSTGRES_DB=sigap
POSTGRES_USER=sigap
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
BACKEND_PORT=8000
ATCS_PORT=8001
FRONTEND_PORT=5173

# Proses Python lokal memakai field ini; Compose mengganti host menjadi db.
SIGAP_DB_HOST=127.0.0.1
SIGAP_DB_PORT=5432
SIGAP_CONFIG_PATH=configs/intersection.json
SIGAP_ATCS_BASE_URL=http://127.0.0.1:8001
# Rahasia antarlayanan, minimal 32 karakter acak. Jangan gunakan variabel VITE_ untuk ini.
SIGAP_CONTROL_API_KEY=
# Aktifkan kedua flag hanya pada prototipe/lab dengan data sintetis Tahap 5.
ATCS_ENABLE_TEST_SOURCE=false
SIGAP_ADAPTIVE_SYNTHETIC=false
# Kamera terpercaya, hanya di server. Jangan gunakan VITE_ untuk URL/kredensial CCTV.
SIGAP_CAMERA_URLS={}
# Video unggahan disimpan di work/media secara default (tidak masuk Git).
SIGAP_YOLO_ENABLED=false
# Pakai pengukuran video ketika YOLO aktif; data buatan tetap tersedia sebagai lab terpisah.
SIGAP_ADAPTIVE_VIDEO=true
SIGAP_YOLO_MODEL=models/sigap_yolo26s/best.pt
# Python khusus vision 3.12/3.13; backend tetap memakai Python 3.14.
SIGAP_VISION_PYTHON=

# Sesi operator: 8 jam absolut. Gunakan true ketika melayani HTTPS.
SIGAP_SESSION_SECONDS=28800
SIGAP_COOKIE_SECURE=false
# Origin browser yang diizinkan; sesuaikan jika port frontend berubah.
SIGAP_ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

# Proxy server Vite; variabel ini tidak dimasukkan ke bundle browser.
BACKEND_PROXY_TARGET=http://127.0.0.1:8000
# Hanya URL publik relatif, bukan token atau password.
VITE_API_BASE_URL=/api

# Video: allow conservative green times up to the configured 150-second baseline.
ATCS_MAXIMUM_GREEN_SECONDS=180
# Persistent event archive, independent from the operator/account database.
# SIGAP_EVENT_ARCHIVE=work/history/events.sqlite3

# Analitik wilayah: key hanya di backend; jangan memakai VITE_ untuk key.
SIGAP_TOMTOM_API_KEY=
SIGAP_TOMTOM_POLL_SECONDS=120
# SIGAP_ANALYTICS_CONFIG=configs/traffic-analytics.json
# SIGAP_ANALYTICS_STORE=work/analytics/traffic.sqlite3
