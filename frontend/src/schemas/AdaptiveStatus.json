{
  "$defs": {
    "AdaptiveDecision": {
      "additionalProperties": false,
      "properties": {
        "decided_at": {
          "format": "date-time",
          "title": "Decided At",
          "type": "string"
        },
        "measurement_sequence": {
          "title": "Measurement Sequence",
          "type": "integer"
        },
        "approach": {
          "anyOf": [
            {
              "enum": [
                "U",
                "T",
                "S",
                "B"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Approach"
        },
        "green_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Green Seconds"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "scores": {
          "additionalProperties": {
            "type": "number"
          },
          "maxProperties": 4,
          "minProperties": 4,
          "propertyNames": {
            "enum": [
              "U",
              "T",
              "S",
              "B"
            ]
          },
          "title": "Scores",
          "type": "object"
        },
        "inputs": {
          "additionalProperties": {
            "$ref": "#/$defs/ApproachMeasurement"
          },
          "maxProperties": 4,
          "minProperties": 4,
          "propertyNames": {
            "enum": [
              "U",
              "T",
              "S",
              "B"
            ]
          },
          "title": "Inputs",
          "type": "object"
        },
        "request_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        },
        "outcome": {
          "default": "preview",
          "enum": [
            "preview",
            "accepted",
            "applied",
            "rejected",
            "cancelled"
          ],
          "title": "Outcome",
          "type": "string"
        }
      },
      "required": [
        "decided_at",
        "measurement_sequence",
        "approach",
        "green_seconds",
        "reason",
        "scores",
        "inputs",
        "request_id",
        "outcome"
      ],
      "title": "AdaptiveDecision",
      "type": "object"
    },
    "AdaptivePolicyConfig": {
      "additionalProperties": false,
      "properties": {
        "minimum_green": {
          "default": 10,
          "maximum": 60,
          "minimum": 1,
          "title": "Minimum Green",
          "type": "number"
        },
        "maximum_green": {
          "default": 60,
          "maximum": 180,
          "minimum": 1,
          "title": "Maximum Green",
          "type": "number"
        },
        "queue_weight": {
          "default": 4,
          "maximum": 100,
          "minimum": 0,
          "title": "Queue Weight",
          "type": "number"
        },
        "wait_weight": {
          "default": 1,
          "maximum": 100,
          "minimum": 0,
          "title": "Wait Weight",
          "type": "number"
        },
        "age_weight": {
          "default": 0.5,
          "maximum": 100,
          "minimum": 0,
          "title": "Age Weight",
          "type": "number"
        },
        "service_age_target": {
          "default": 120,
          "maximum": 1800,
          "minimum": 10,
          "title": "Service Age Target",
          "type": "number"
        },
        "seconds_per_queued_vehicle": {
          "default": 2,
          "maximum": 10,
          "minimum": 0.1,
          "title": "Seconds Per Queued Vehicle",
          "type": "number"
        },
        "data_timeout": {
          "default": 3,
          "maximum": 30,
          "minimum": 0.5,
          "title": "Data Timeout",
          "type": "number"
        }
      },
      "required": [
        "minimum_green",
        "maximum_green",
        "queue_weight",
        "wait_weight",
        "age_weight",
        "service_age_target",
        "seconds_per_queued_vehicle",
        "data_timeout"
      ],
      "title": "AdaptivePolicyConfig",
      "type": "object"
    },
    "ApproachMeasurement": {
      "additionalProperties": false,
      "properties": {
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "usable": {
          "title": "Usable",
          "type": "boolean"
        },
        "controlled_count": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Controlled Count",
          "type": "integer"
        },
        "queue_count": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Queue Count",
          "type": "integer"
        },
        "oldest_wait_seconds": {
          "minimum": 0,
          "title": "Oldest Wait Seconds",
          "type": "number"
        },
        "slip_count": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Slip Count",
          "type": "integer"
        },
        "exit_available": {
          "title": "Exit Available",
          "type": "boolean"
        }
      },
      "required": [
        "observed_at",
        "usable",
        "controlled_count",
        "queue_count",
        "oldest_wait_seconds",
        "slip_count",
        "exit_available"
      ],
      "title": "ApproachMeasurement",
      "type": "object"
    },
    "MeasurementBatch": {
      "additionalProperties": false,
      "properties": {
        "intersection_id": {
          "title": "Intersection Id",
          "type": "string"
        },
        "source": {
          "enum": [
            "synthetic",
            "recording",
            "cctv"
          ],
          "title": "Source",
          "type": "string"
        },
        "source_session": {
          "format": "uuid",
          "title": "Source Session",
          "type": "string"
        },
        "sequence": {
          "minimum": 0,
          "title": "Sequence",
          "type": "integer"
        },
        "approaches": {
          "additionalProperties": {
            "$ref": "#/$defs/ApproachMeasurement"
          },
          "maxProperties": 4,
          "minProperties": 4,
          "propertyNames": {
            "enum": [
              "U",
              "T",
              "S",
              "B"
            ]
          },
          "title": "Approaches",
          "type": "object"
        }
      },
      "required": [
        "intersection_id",
        "source",
        "source_session",
        "sequence",
        "approaches"
      ],
      "title": "MeasurementBatch",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "enabled": {
      "title": "Enabled",
      "type": "boolean"
    },
    "source": {
      "const": "synthetic",
      "title": "Source",
      "type": "string"
    },
    "fault": {
      "enum": [
        "none",
        "frozen_data",
        "invalid_data",
        "sender_stopped"
      ],
      "title": "Fault",
      "type": "string"
    },
    "status": {
      "enum": [
        "disabled",
        "ready",
        "active",
        "unavailable"
      ],
      "title": "Status",
      "type": "string"
    },
    "message": {
      "title": "Message",
      "type": "string"
    },
    "policy": {
      "$ref": "#/$defs/AdaptivePolicyConfig"
    },
    "measurements": {
      "anyOf": [
        {
          "$ref": "#/$defs/MeasurementBatch"
        },
        {
          "type": "null"
        }
      ]
    },
    "decisions": {
      "items": {
        "$ref": "#/$defs/AdaptiveDecision"
      },
      "title": "Decisions",
      "type": "array"
    }
  },
  "required": [
    "enabled",
    "source",
    "fault",
    "status",
    "message",
    "policy",
    "measurements",
    "decisions"
  ],
  "title": "AdaptiveStatus",
  "type": "object"
}
