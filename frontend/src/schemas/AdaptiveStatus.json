{
  "$defs": {
    "AdaptiveDecision": {
      "additionalProperties": false,
      "properties": {
        "decided_at": {
          "format": "date-time",
          "title": "Decided At",
          "type": "string"
        },
        "measurement_sequence": {
          "title": "Measurement Sequence",
          "type": "integer"
        },
        "approach": {
          "anyOf": [
            {
              "enum": [
                "U",
                "T",
                "S",
                "B"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Approach"
        },
        "green_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Green Seconds"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "scores": {
          "additionalProperties": {
            "type": "number"
          },
          "maxProperties": 4,
          "minProperties": 4,
          "propertyNames": {
            "enum": [
              "U",
              "T",
              "S",
              "B"
            ]
          },
          "title": "Scores",
          "type": "object"
        },
        "inputs": {
          "additionalProperties": {
            "$ref": "#/$defs/ApproachMeasurement"
          },
          "maxProperties": 4,
          "minProperties": 4,
          "propertyNames": {
            "enum": [
              "U",
              "T",
              "S",
              "B"
            ]
          },
          "title": "Inputs",
          "type": "object"
        },
        "request_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        },
        "outcome": {
          "default": "preview",
          "enum": [
            "preview",
            "accepted",
            "applied",
            "rejected",
            "cancelled"
          ],
          "title": "Outcome",
          "type": "string"
        }
      },
      "required": [
        "decided_at",
        "measurement_sequence",
        "approach",
        "green_seconds",
        "reason",
        "scores",
        "inputs",
        "request_id",
        "outcome"
      ],
      "title": "AdaptiveDecision",
      "type": "object"
    },
    "AdaptivePolicyConfig": {
      "additionalProperties": false,
      "properties": {
        "video_baseline_floor_ratio": {
          "default": 0.75,
          "maximum": 1,
          "minimum": 0.1,
          "title": "Video Baseline Floor Ratio",
          "type": "number"
        },
        "video_maximum_drop_ratio": {
          "default": 0.2,
          "maximum": 0.5,
          "minimum": 0.01,
          "title": "Video Maximum Drop Ratio",
          "type": "number"
        },
        "minimum_green": {
          "default": 10,
          "maximum": 60,
          "minimum": 1,
          "title": "Minimum Green",
          "type": "number"
        },
        "maximum_green": {
          "default": 60,
          "maximum": 180,
          "minimum": 1,
          "title": "Maximum Green",
          "type": "number"
        },
        "queue_weight": {
          "default": 4,
          "maximum": 100,
          "minimum": 0,
          "title": "Queue Weight",
          "type": "number"
        },
        "wait_weight": {
          "default": 1,
          "maximum": 100,
          "minimum": 0,
          "title": "Wait Weight",
          "type": "number"
        },
        "age_weight": {
          "default": 0.5,
          "maximum": 100,
          "minimum": 0,
          "title": "Age Weight",
          "type": "number"
        },
        "service_age_target": {
          "default": 120,
          "maximum": 1800,
          "minimum": 10,
          "title": "Service Age Target",
          "type": "number"
        },
        "seconds_per_queued_vehicle": {
          "default": 2,
          "maximum": 10,
          "minimum": 0.1,
          "title": "Seconds Per Queued Vehicle",
          "type": "number"
        },
        "data_timeout": {
          "default": 3,
          "maximum": 30,
          "minimum": 0.5,
          "title": "Data Timeout",
          "type": "number"
        }
      },
      "required": [
        "video_baseline_floor_ratio",
        "video_maximum_drop_ratio",
        "minimum_green",
        "maximum_green",
        "queue_weight",
        "wait_weight",
        "age_weight",
        "service_age_target",
        "seconds_per_queued_vehicle",
        "data_timeout"
      ],
      "title": "AdaptivePolicyConfig",
      "type": "object"
    },
    "ApproachMeasurement": {
      "additionalProperties": false,
      "properties": {
        "queue_visibility": {
          "default": "partial",
          "enum": [
            "full",
            "partial"
          ],
          "title": "Queue Visibility",
          "type": "string"
        },
        "occupancy_ratio": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Occupancy Ratio",
          "type": "number"
        },
        "queue_reaches_boundary": {
          "default": false,
          "title": "Queue Reaches Boundary",
          "type": "boolean"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "usable": {
          "title": "Usable",
          "type": "boolean"
        },
        "controlled_count": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Controlled Count",
          "type": "integer"
        },
        "queue_count": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Queue Count",
          "type": "integer"
        },
        "oldest_wait_seconds": {
          "minimum": 0,
          "title": "Oldest Wait Seconds",
          "type": "number"
        },
        "slip_count": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Slip Count",
          "type": "integer"
        },
        "exit_available": {
          "title": "Exit Available",
          "type": "boolean"
        }
      },
      "required": [
        "queue_visibility",
        "occupancy_ratio",
        "queue_reaches_boundary",
        "observed_at",
        "usable",
        "controlled_count",
        "queue_count",
        "oldest_wait_seconds",
        "slip_count",
        "exit_available"
      ],
      "title": "ApproachMeasurement",
      "type": "object"
    },
    "EmergencyStatus": {
      "additionalProperties": false,
      "properties": {
        "state": {
          "default": "idle",
          "enum": [
            "idle",
            "confirming",
            "confirmed",
            "servicing",
            "recovering",
            "unavailable"
          ],
          "title": "State",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/EmergencyTarget"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "candidates": {
          "items": {
            "$ref": "#/$defs/EmergencyTarget"
          },
          "maxItems": 32,
          "title": "Candidates",
          "type": "array"
        },
        "focus": {
          "default": false,
          "title": "Focus",
          "type": "boolean"
        },
        "message": {
          "default": "Tidak ada EVP terkonfirmasi.",
          "title": "Message",
          "type": "string"
        },
        "events": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Events",
          "type": "array"
        }
      },
      "required": [
        "state",
        "target",
        "candidates",
        "focus",
        "message",
        "events"
      ],
      "title": "EmergencyStatus",
      "type": "object"
    },
    "EmergencyTarget": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Event Id",
          "type": "string"
        },
        "direction": {
          "enum": [
            "U",
            "T",
            "S",
            "B"
          ],
          "title": "Direction",
          "type": "string"
        },
        "source_session": {
          "format": "uuid",
          "title": "Source Session",
          "type": "string"
        },
        "track_id": {
          "minimum": 1,
          "title": "Track Id",
          "type": "integer"
        },
        "kind": {
          "enum": [
            "ambulance",
            "fire_truck"
          ],
          "title": "Kind",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "distance_to_stop": {
          "maximum": 1,
          "minimum": 0,
          "title": "Distance To Stop",
          "type": "number"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        }
      },
      "required": [
        "event_id",
        "direction",
        "source_session",
        "track_id",
        "kind",
        "confidence",
        "distance_to_stop",
        "observed_at"
      ],
      "title": "EmergencyTarget",
      "type": "object"
    },
    "MeasurementBatch": {
      "additionalProperties": false,
      "properties": {
        "intersection_id": {
          "title": "Intersection Id",
          "type": "string"
        },
        "source": {
          "enum": [
            "synthetic",
            "recording",
            "cctv"
          ],
          "title": "Source",
          "type": "string"
        },
        "source_session": {
          "format": "uuid",
          "title": "Source Session",
          "type": "string"
        },
        "sequence": {
          "minimum": 0,
          "title": "Sequence",
          "type": "integer"
        },
        "approaches": {
          "additionalProperties": {
            "$ref": "#/$defs/ApproachMeasurement"
          },
          "maxProperties": 4,
          "minProperties": 4,
          "propertyNames": {
            "enum": [
              "U",
              "T",
              "S",
              "B"
            ]
          },
          "title": "Approaches",
          "type": "object"
        }
      },
      "required": [
        "intersection_id",
        "source",
        "source_session",
        "sequence",
        "approaches"
      ],
      "title": "MeasurementBatch",
      "type": "object"
    },
    "VehicleView": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minimum": 1,
          "title": "Id",
          "type": "integer"
        },
        "origin": {
          "enum": [
            "U",
            "T",
            "S",
            "B"
          ],
          "title": "Origin",
          "type": "string"
        },
        "movement": {
          "enum": [
            "left",
            "straight",
            "right"
          ],
          "title": "Movement",
          "type": "string"
        },
        "kind": {
          "enum": [
            "car",
            "ambulance",
            "fire_engine"
          ],
          "title": "Kind",
          "type": "string"
        },
        "x": {
          "maximum": 1220,
          "minimum": -420,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 1220,
          "minimum": -420,
          "title": "Y",
          "type": "number"
        },
        "heading": {
          "maximum": 180,
          "minimum": -180,
          "title": "Heading",
          "type": "number"
        },
        "stopped": {
          "title": "Stopped",
          "type": "boolean"
        },
        "served": {
          "title": "Served",
          "type": "boolean"
        },
        "distance_to_stop": {
          "minimum": 0,
          "title": "Distance To Stop",
          "type": "number"
        },
        "lane": {
          "enum": [
            "outer",
            "middle",
            "inner"
          ],
          "title": "Lane",
          "type": "string"
        },
        "target_lane": {
          "enum": [
            "outer",
            "middle",
            "inner"
          ],
          "title": "Target Lane",
          "type": "string"
        },
        "changing_to": {
          "anyOf": [
            {
              "enum": [
                "outer",
                "middle",
                "inner"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Changing To"
        },
        "stop_reason": {
          "anyOf": [
            {
              "enum": [
                "following",
                "yielding",
                "signal",
                "exit_blocked",
                "conflict",
                "safety_gap",
                "stationary"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stop Reason"
        }
      },
      "required": [
        "id",
        "origin",
        "movement",
        "kind",
        "x",
        "y",
        "heading",
        "stopped",
        "served",
        "distance_to_stop",
        "lane",
        "target_lane",
        "changing_to",
        "stop_reason"
      ],
      "title": "VehicleView",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "enabled": {
      "title": "Enabled",
      "type": "boolean"
    },
    "source": {
      "enum": [
        "synthetic",
        "recording",
        "cctv"
      ],
      "title": "Source",
      "type": "string"
    },
    "fault": {
      "enum": [
        "none",
        "frozen_data",
        "invalid_data",
        "sender_stopped"
      ],
      "title": "Fault",
      "type": "string"
    },
    "status": {
      "enum": [
        "disabled",
        "ready",
        "active",
        "unavailable"
      ],
      "title": "Status",
      "type": "string"
    },
    "message": {
      "title": "Message",
      "type": "string"
    },
    "policy": {
      "$ref": "#/$defs/AdaptivePolicyConfig"
    },
    "measurements": {
      "anyOf": [
        {
          "$ref": "#/$defs/MeasurementBatch"
        },
        {
          "type": "null"
        }
      ]
    },
    "decisions": {
      "items": {
        "$ref": "#/$defs/AdaptiveDecision"
      },
      "title": "Decisions",
      "type": "array"
    },
    "auto_resume": {
      "default": false,
      "title": "Auto Resume",
      "type": "boolean"
    },
    "source_sessions": {
      "additionalProperties": {
        "format": "uuid",
        "type": "string"
      },
      "propertyNames": {
        "enum": [
          "U",
          "T",
          "S",
          "B"
        ]
      },
      "title": "Source Sessions",
      "type": "object"
    },
    "issues": {
      "additionalProperties": {
        "type": "string"
      },
      "propertyNames": {
        "enum": [
          "U",
          "T",
          "S",
          "B"
        ]
      },
      "title": "Issues",
      "type": "object"
    },
    "map_vehicles": {
      "items": {
        "$ref": "#/$defs/VehicleView"
      },
      "title": "Map Vehicles",
      "type": "array"
    },
    "emergency": {
      "$ref": "#/$defs/EmergencyStatus"
    }
  },
  "required": [
    "enabled",
    "source",
    "fault",
    "status",
    "message",
    "policy",
    "measurements",
    "decisions",
    "auto_resume",
    "source_sessions",
    "issues",
    "map_vehicles",
    "emergency"
  ],
  "title": "AdaptiveStatus",
  "type": "object"
}
