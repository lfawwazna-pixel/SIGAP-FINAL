{
  "$defs": {
    "AdaptiveDecision": {
      "additionalProperties": false,
      "properties": {
        "decided_at": {
          "format": "date-time",
          "title": "Decided At",
          "type": "string"
        },
        "measurement_sequence": {
          "title": "Measurement Sequence",
          "type": "integer"
        },
        "approach": {
          "anyOf": [
            {
              "enum": [
                "U",
                "T",
                "S",
                "B"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Approach"
        },
        "green_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Green Seconds"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "scores": {
          "additionalProperties": {
            "type": "number"
          },
          "maxProperties": 4,
          "minProperties": 4,
          "propertyNames": {
            "enum": [
              "U",
              "T",
              "S",
              "B"
            ]
          },
          "title": "Scores",
          "type": "object"
        },
        "inputs": {
          "additionalProperties": {
            "$ref": "#/$defs/ApproachMeasurement"
          },
          "maxProperties": 4,
          "minProperties": 4,
          "propertyNames": {
            "enum": [
              "U",
              "T",
              "S",
              "B"
            ]
          },
          "title": "Inputs",
          "type": "object"
        },
        "request_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        },
        "outcome": {
          "default": "preview",
          "enum": [
            "preview",
            "accepted",
            "applied",
            "rejected",
            "cancelled"
          ],
          "title": "Outcome",
          "type": "string"
        }
      },
      "required": [
        "decided_at",
        "measurement_sequence",
        "approach",
        "green_seconds",
        "reason",
        "scores",
        "inputs",
        "request_id",
        "outcome"
      ],
      "title": "AdaptiveDecision",
      "type": "object"
    },
    "ApproachMeasurement": {
      "additionalProperties": false,
      "properties": {
        "queue_visibility": {
          "default": "partial",
          "enum": [
            "full",
            "partial"
          ],
          "title": "Queue Visibility",
          "type": "string"
        },
        "occupancy_ratio": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Occupancy Ratio",
          "type": "number"
        },
        "queue_reaches_boundary": {
          "default": false,
          "title": "Queue Reaches Boundary",
          "type": "boolean"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "usable": {
          "title": "Usable",
          "type": "boolean"
        },
        "controlled_count": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Controlled Count",
          "type": "integer"
        },
        "queue_count": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Queue Count",
          "type": "integer"
        },
        "oldest_wait_seconds": {
          "minimum": 0,
          "title": "Oldest Wait Seconds",
          "type": "number"
        },
        "slip_count": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Slip Count",
          "type": "integer"
        },
        "exit_available": {
          "title": "Exit Available",
          "type": "boolean"
        }
      },
      "required": [
        "queue_visibility",
        "occupancy_ratio",
        "queue_reaches_boundary",
        "observed_at",
        "usable",
        "controlled_count",
        "queue_count",
        "oldest_wait_seconds",
        "slip_count",
        "exit_available"
      ],
      "title": "ApproachMeasurement",
      "type": "object"
    },
    "ExperimentEvent": {
      "additionalProperties": false,
      "properties": {
        "time": {
          "minimum": 0,
          "title": "Time",
          "type": "number"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "time",
        "message"
      ],
      "title": "ExperimentEvent",
      "type": "object"
    },
    "VehicleView": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minimum": 1,
          "title": "Id",
          "type": "integer"
        },
        "origin": {
          "enum": [
            "U",
            "T",
            "S",
            "B"
          ],
          "title": "Origin",
          "type": "string"
        },
        "movement": {
          "enum": [
            "left",
            "straight",
            "right"
          ],
          "title": "Movement",
          "type": "string"
        },
        "kind": {
          "enum": [
            "car",
            "motorcycle",
            "bus",
            "truck",
            "ambulance",
            "fire_engine"
          ],
          "title": "Kind",
          "type": "string"
        },
        "x": {
          "maximum": 1220,
          "minimum": -420,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 1220,
          "minimum": -420,
          "title": "Y",
          "type": "number"
        },
        "heading": {
          "maximum": 180,
          "minimum": -180,
          "title": "Heading",
          "type": "number"
        },
        "stopped": {
          "title": "Stopped",
          "type": "boolean"
        },
        "served": {
          "title": "Served",
          "type": "boolean"
        },
        "distance_to_stop": {
          "minimum": 0,
          "title": "Distance To Stop",
          "type": "number"
        },
        "lane": {
          "enum": [
            "outer",
            "middle",
            "inner"
          ],
          "title": "Lane",
          "type": "string"
        },
        "target_lane": {
          "enum": [
            "outer",
            "middle",
            "inner"
          ],
          "title": "Target Lane",
          "type": "string"
        },
        "changing_to": {
          "anyOf": [
            {
              "enum": [
                "outer",
                "middle",
                "inner"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Changing To"
        },
        "stop_reason": {
          "anyOf": [
            {
              "enum": [
                "following",
                "yielding",
                "signal",
                "exit_blocked",
                "conflict",
                "safety_gap",
                "stationary"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stop Reason"
        }
      },
      "required": [
        "id",
        "origin",
        "movement",
        "kind",
        "x",
        "y",
        "heading",
        "stopped",
        "served",
        "distance_to_stop",
        "lane",
        "target_lane",
        "changing_to",
        "stop_reason"
      ],
      "title": "VehicleView",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "decision": {
      "anyOf": [
        {
          "$ref": "#/$defs/AdaptiveDecision"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "intersection_id": {
      "title": "Intersection Id",
      "type": "string"
    },
    "source": {
      "enum": [
        "atcs_synthetic",
        "experiment"
      ],
      "title": "Source",
      "type": "string"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "available": {
      "title": "Available",
      "type": "boolean"
    },
    "time_seconds": {
      "minimum": 0,
      "title": "Time Seconds",
      "type": "number"
    },
    "running": {
      "title": "Running",
      "type": "boolean"
    },
    "speed": {
      "enum": [
        1,
        2,
        3
      ],
      "title": "Speed",
      "type": "integer"
    },
    "strategy": {
      "enum": [
        "fixed_time",
        "adaptive"
      ],
      "title": "Strategy",
      "type": "string"
    },
    "phase": {
      "anyOf": [
        {
          "enum": [
            "green",
            "yellow",
            "all_red"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Phase"
    },
    "active_approach": {
      "anyOf": [
        {
          "enum": [
            "U",
            "T",
            "S",
            "B"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Active Approach"
    },
    "signals": {
      "anyOf": [
        {
          "additionalProperties": {
            "enum": [
              "red",
              "yellow",
              "green"
            ],
            "type": "string"
          },
          "propertyNames": {
            "enum": [
              "U",
              "T",
              "S",
              "B"
            ]
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "title": "Signals"
    },
    "remaining_seconds": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Remaining Seconds"
    },
    "emergency": {
      "title": "Emergency",
      "type": "boolean"
    },
    "target_vehicle": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Target Vehicle"
    },
    "reason": {
      "title": "Reason",
      "type": "string"
    },
    "demand": {
      "additionalProperties": {
        "maximum": 60,
        "minimum": 0,
        "type": "integer"
      },
      "propertyNames": {
        "enum": [
          "U",
          "T",
          "S",
          "B"
        ]
      },
      "title": "Demand",
      "type": "object"
    },
    "blocked_exit": {
      "anyOf": [
        {
          "enum": [
            "U",
            "T",
            "S",
            "B"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Blocked Exit"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/ExperimentEvent"
      },
      "maxItems": 100,
      "title": "Events",
      "type": "array"
    },
    "evp_queue": {
      "items": {
        "type": "integer"
      },
      "maxItems": 160,
      "title": "Evp Queue",
      "type": "array"
    },
    "vehicles": {
      "items": {
        "$ref": "#/$defs/VehicleView"
      },
      "maxItems": 160,
      "title": "Vehicles",
      "type": "array"
    },
    "queues": {
      "additionalProperties": {
        "minimum": 0,
        "type": "integer"
      },
      "propertyNames": {
        "enum": [
          "U",
          "T",
          "S",
          "B"
        ]
      },
      "title": "Queues",
      "type": "object"
    },
    "completed": {
      "minimum": 0,
      "title": "Completed",
      "type": "integer"
    },
    "average_wait": {
      "minimum": 0,
      "title": "Average Wait",
      "type": "number"
    },
    "waiting_seconds": {
      "minimum": 0,
      "title": "Waiting Seconds",
      "type": "number"
    },
    "refused_spawns": {
      "minimum": 0,
      "title": "Refused Spawns",
      "type": "integer"
    },
    "conflict": {
      "enum": [
        "clear",
        "occupied",
        "unknown"
      ],
      "title": "Conflict",
      "type": "string"
    },
    "traffic_sequence": {
      "minimum": 0,
      "title": "Traffic Sequence",
      "type": "integer"
    }
  },
  "required": [
    "decision",
    "intersection_id",
    "source",
    "run_id",
    "observed_at",
    "available",
    "time_seconds",
    "running",
    "speed",
    "strategy",
    "phase",
    "active_approach",
    "signals",
    "remaining_seconds",
    "emergency",
    "target_vehicle",
    "reason",
    "demand",
    "blocked_exit",
    "events",
    "evp_queue",
    "vehicles",
    "queues",
    "completed",
    "average_wait",
    "waiting_seconds",
    "refused_spawns",
    "conflict",
    "traffic_sequence"
  ],
  "title": "TrafficView",
  "type": "object"
}
