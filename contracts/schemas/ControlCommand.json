{
  "$defs": {
    "EmergencyTarget": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Event Id",
          "type": "string"
        },
        "direction": {
          "enum": [
            "U",
            "T",
            "S",
            "B"
          ],
          "title": "Direction",
          "type": "string"
        },
        "source_session": {
          "format": "uuid",
          "title": "Source Session",
          "type": "string"
        },
        "track_id": {
          "minimum": 1,
          "title": "Track Id",
          "type": "integer"
        },
        "kind": {
          "enum": [
            "ambulance",
            "fire_truck"
          ],
          "title": "Kind",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "distance_to_stop": {
          "maximum": 1,
          "minimum": 0,
          "title": "Distance To Stop",
          "type": "number"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        }
      },
      "required": [
        "event_id",
        "direction",
        "source_session",
        "track_id",
        "kind",
        "confidence",
        "distance_to_stop",
        "observed_at"
      ],
      "title": "EmergencyTarget",
      "type": "object"
    },
    "Observation": {
      "additionalProperties": false,
      "properties": {
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "usable": {
          "title": "Usable",
          "type": "boolean"
        }
      },
      "required": [
        "observed_at",
        "usable"
      ],
      "title": "Observation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "atcs_run_id": {
      "format": "uuid",
      "title": "Atcs Run Id",
      "type": "string"
    },
    "sender_id": {
      "format": "uuid",
      "title": "Sender Id",
      "type": "string"
    },
    "action": {
      "enum": [
        "observe",
        "activate",
        "heartbeat",
        "plan",
        "release",
        "priority"
      ],
      "title": "Action",
      "type": "string"
    },
    "issued_at": {
      "format": "date-time",
      "title": "Issued At",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "session_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Session Id"
    },
    "sequence": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sequence"
    },
    "expected_revision": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Revision"
    },
    "source": {
      "anyOf": [
        {
          "enum": [
            "cctv",
            "integration_test"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source"
    },
    "observations": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/Observation"
          },
          "propertyNames": {
            "enum": [
              "U",
              "T",
              "S",
              "B"
            ]
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Observations"
    },
    "approach": {
      "anyOf": [
        {
          "enum": [
            "U",
            "T",
            "S",
            "B"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Approach"
    },
    "green_seconds": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "maximum": 180,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Green Seconds"
    },
    "plan_valid_until": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Plan Valid Until"
    },
    "priority_target": {
      "anyOf": [
        {
          "$ref": "#/$defs/EmergencyTarget"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "request_id",
    "atcs_run_id",
    "sender_id",
    "action",
    "issued_at",
    "expires_at"
  ],
  "title": "ControlCommand",
  "type": "object"
}
